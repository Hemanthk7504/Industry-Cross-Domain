# ==============================================================================
# CrossDomain AI Environment Configuration
# ==============================================================================

# Application Security
SECRET_KEY=super-secure-cross-domain-industrial-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Database Configuration (SQLAlchemy)
# ------------------------------------------------------------------------------
# 1. Active: SQLite (Default Local Database)
DATABASE_URL=sqlite:///./industrial_cross_domain.db

# 2. To switch to PostgreSQL later:
# Uncomment the line below and fill in your PostgreSQL credentials:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/cross_domain_ai
# For cloud PostgreSQL (Neon, Supabase, AWS RDS, Render, Heroku):
# DATABASE_URL=postgresql+psycopg2://username:password@ep-host.region.aws.neon.tech/dbname?sslmode=require
